# =========================================================================
# PLANTILLA DE CONFIGURACIÓN - SYNCEDU PORTAL (.env.example)
# =========================================================================
# Copia este archivo como '.env' en la raíz de 'apps/web/portal/' en tu nueva laptop
# y completa los campos con tus claves de API correspondientes.

# 1. INTEGRACIÓN PRINCIPAL: n8n Cloud Webhook URL
N8N_WEBHOOK_URL=

# 2. INTEGRACIONES DIRECTAS Y FALLBACK (Opcionales)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
